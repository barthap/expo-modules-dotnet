{
  "name": "desktop-app",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "pnpm start:bundler",
    "start:bundler": "expo start --localhost",
    "macos": "pnpm run:macos",
    "run:macos": "react-native run-macos",
    "windows": "pnpm run:windows",
    "run:windows": "react-native run-windows",
    "autolink:windows": "expo-modules-dotnet-autolinking sync-windows --sln windows/DesktopApp.sln --proj windows/DesktopApp/DesktopApp.vcxproj",
    "build:managed": "expo-modules-dotnet-autolinking link --platform macos",
    "build:managed:windows": "expo-modules-dotnet-autolinking link --platform windows",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/runtime": "7.29.7",
    "example-module": "workspace:*",
    "expo": "catalog:react-native-81",
    "expo-desktop": "^0.1.37",
    "expo-desktop-config-plugins": "^1.1.34",
    "expo-desktop-modules-core": "^54.0.13",
    "expo-desktop-prebuild-config": "^1.0.20",
    "expo-desktop-stubs": "^54.0.13",
    "expo-modules-dotnet": "workspace:*",
    "react": "catalog:react-native-81",
    "react-native": "catalog:react-native-81",
    "react-native-macos": "catalog:react-native-81",
    "react-native-windows": "catalog:react-native-81"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.1.3",
    "@react-native/metro-config": "catalog:react-native-81",
    "@rnx-kit/metro-config": "^2.2.4",
    "@types/react": "catalog:react-native-81",
    "expo-modules-dotnet-autolinking": "workspace:*",
    "typescript": "^5.9.2"
  },
  "react-native-windows": {
    "init-windows": {
      "name": "DesktopApp",
      "namespace": "DesktopApp",
      "template": "cpp-app"
    }
  }
}
