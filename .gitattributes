# Normalize text in the repository. Specific checkout line endings are
# only pinned where toolchains require them.
* text=auto
.gitattributes text eol=lf

# Files executed by Unix shells must stay LF on every platform.
*.sh text eol=lf
.envrc text eol=lf
*.podspec text eol=lf
*.xcode.env text eol=lf

# Binary files tracked by this repository must never be line-ending normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.pdf binary
*.zip binary
*.gz binary
*.tgz binary
*.pyc binary
