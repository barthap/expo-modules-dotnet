{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "repo_root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" && python3 \"$repo_root/.codex/hooks/stop_format_check.py\" || true",
            "timeout": 120,
            "statusMessage": "Checking repository formatting"
          }
        ]
      }
    ]
  }
}
