{
  "name": "expo-modules-dotnet",
  "version": "0.1.0",
  "description": "Expo adapter for .NET-backed Expo modules",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "expo-desktop-template-bare-minimum": "54.81.5",
    "typescript": "catalog:react-native-86",
    "vitest": "^3.0.0",
    "xcode": "^3.0.1"
  },
  "codegenConfig": {
    "name": "ExpoModulesDotnetSpec",
    "type": "modules",
    "jsSrcsDir": "./src",
    "android": {
      "javaPackageName": "expo.modules.dotnet"
    },
    "ios": {
      "modules": {
        "ExpoModulesDotnetInstaller": {
          "className": "ExpoModulesDotnetInstaller"
        }
      }
    }
  }
}
