<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="ReactNativeWindowsExperimentalFeatures">
    <UseWinUI3>false</UseWinUI3>
    <UseHermes>true</UseHermes>
    <UseFabric>false</UseFabric>
    <UseExperimentalNuget>true</UseExperimentalNuget>
    <HermesPlatform Condition="'$(HermesPlatform)' == '' and '$(Platform)' == 'Win32'">x86</HermesPlatform>
    <HermesPlatform Condition="'$(HermesPlatform)' == '' and '$(Platform)' == 'x64'">x64</HermesPlatform>
    <HermesPlatform Condition="'$(HermesPlatform)' == '' and '$(Platform)' == 'ARM64'">arm64</HermesPlatform>
    <HermesPlatform Condition="'$(HermesPlatform)' == '' and '$(Platform)' == 'ARM64EC'">arm64ec</HermesPlatform>
    <ReactExperimentalFeaturesSet>true</ReactExperimentalFeaturesSet>
  </PropertyGroup>
</Project>
