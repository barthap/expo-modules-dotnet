<?xml version="1.0" encoding="utf-8"?>
<!-- Imported by the app .vcxproj that expo-modules-dotnet's config plugin wires during expo-desktop prebuild. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildThisFileDirectory)ExpoDotnetAutolink.targets" />
  <Target Name="CopyExpoDotnetManagedArtifacts" AfterTargets="Build">
    <ItemGroup>
      <ExpoDotnetManagedArtifacts Include="$(ExpoDotnetManagedDir)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ExpoDotnetManagedArtifacts)" DestinationFiles="@(ExpoDotnetManagedArtifacts->'$(OutDir)Managed\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <!-- The copy never deletes, and the adapter probes $(OutDir)Managed first, so a
         removed app.config must not survive there.
         @ref docs/specs/dotnet-autolinking.md "Staging Writes The App Config For Modules That Declare It" -->
    <Delete Files="$(OutDir)Managed\app.config" Condition="!Exists('$(ExpoDotnetManagedDir)app.config')" />
  </Target>
</Project>
