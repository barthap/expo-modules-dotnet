<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Expo.ModulesCore/Expo.ModulesCore.csproj" />
    <ProjectReference Include="../Expo.ModulesCore.Testing/Expo.ModulesCore.Testing.csproj" />
    <ProjectReference
      Include="../Expo.ModulesCore.Generator/Expo.ModulesCore.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
