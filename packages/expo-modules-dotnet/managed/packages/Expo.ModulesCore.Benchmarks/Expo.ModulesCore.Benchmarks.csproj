<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <!-- Measured samples must be steady state. With tiering on, the first samples run unoptimized code
         and the median depends on where the JIT step lands. -->
    <!-- @ref docs/specs/hermes-testhost.md "Canonical Benchmark Runners" -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../../../../scripts/hermes-ref.txt" LogicalName="hermes-ref.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Expo.ModulesCore/Expo.ModulesCore.csproj" />
    <ProjectReference Include="../Expo.ModulesCore.Testing/Expo.ModulesCore.Testing.csproj" />
    <ProjectReference
      Include="../Expo.ModulesCore.Generator/Expo.ModulesCore.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
